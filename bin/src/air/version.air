_ do _[
    _version set _ import .language.version,
    _generate_pretty set _ import .language.syntax.generate_pretty.context.let,
    _join set _ import .text.join,
    _(major : minor : patch) is version,
    _major set _major generate_pretty .,
    _minor set _minor generate_pretty .,
    _patch set _patch generate_pretty .,
    "" join ["v", major, ".", minor, ".", patch]
]
