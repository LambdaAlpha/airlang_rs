!"Syntax Design Rules"_
.'- No numeric indices; only name-based indexing'_
.'- Use common, well-known words; avoid obscure abbreviations or compound words'_
.'- Named entity names are placed on the left side of a pair'_
.'- Module entity lists, function bodies, and block bodies are placed on the right side of a pair'_
.'- Use call functions to express categories'_
.'- Use the presence of a key in a map to express boolean attributes'_
.'- One-to-one instruction mapping; do not merge similar instructions'_
.'- Zero-arg and single-arg instructions use the standard form'_
.'- Multi-arg instructions do not require remembering argument order;'_
|' use a pair if there is a clearly best order, otherwise use a map'_
.''

{
    @module : {start : @function_name} module [@entity],
    @entity : [
        @import, @export, @global, @memory, @data, @table, @element, @tag,
        @function, @type,
    ],
    @import : @text import @import_items,
    @import_items : [@import_item, [@import_item]],
    @import_item : @text : @import_kind,
    @import_kind : [
        @function_import,
        @global_import,
        @memory,
        @table_import,
        @tag,
    ],
    @export : @text export _ @export_kind @name,
    @export_kind : [function, global, memory, table, tag],
    @global : @global_name global {..@global_kind, init : @constant_expression},
    @global_import : @global_name global @global_kind,
    @global_kind : {shared, mutable, type : @value_type},
    @global_name : @name,
    @memory : @memory_name memory {shared, 64, min : @int, max : @int},
    @memory_name : @name,
    @data : @data_name data {memory : @memory_name, offset : @constant_expression, init : @data_init},
    @data_init : [@text, @byte],
    @data_name : @name,
    @table : @table_name table {..@table_kind, init : @constant_expression},
    @table_import : @table_name table @table_kind,
    @table_kind : {shared, 64, min : @int, max : @int, type : @reference_type},
    @table_name : @name,
    @element : @element_name element {
        type : @element_type,
        declare,
        table : @table_name,
        offset : @constant_expression,
        init : @element_init,
    },
    @element_type : [function, @reference_type],
    @element_init : [[@function_name], [@constant_expression]],
    @element_name : @name,
    @tag : @tag_name tag {attribute : @tag_attribute, type : @function_type_name},
    @tag_attribute : [exception],
    @tag_name : @name,
    @function : @function_name function {type : @function_type_name,
        input : [@name], local : [@name : @value_type]} : [@instruction],
    @function_import : @function_name function {exact, type : @function_type_name},
    @function_name : @name,
    @instruction : [
        @zero_argument_instruction,
        @local_instruction,
        @block_instruction,
        @branch_instruction,
        @call_instruction,
        @switch_instruction,
        @global_instruction,
        @memory_instruction,
        @data_instruction,
        @table_instruction,
        @element_instruction,
        @reference_instruction,
        @struct_instruction,
        @array_instruction,
        @number_instruction,
        ...,
    ],
    @zero_argument_instruction : [unreachable, nop, return, drop, ...],
    @block_instruction : [
        @block_info block [@instruction],
        @block_info if @if_branch,
        @block_info loop [@instruction],
        @block_info try_table [@instruction] : [{reference, tag : @tag_name, label : @label}],
    ],
    @block_info : {label : @label, type : @block_type},
    @block_type : [@value_type, @function_type_name],
    @label : @name,
    @branch_instruction : [
        _ branch @label,
        _ branch_if @label,
        _ branch_on_null @label,
        _ branch_on_non_null @label,
        _ branch_table [@label],
        _ branch_on_cast @branch_on_cast_argument,
        _ branch_on_cast_fail @branch_on_cast_argument,
        _ branch_on_cast_descriptor_equal @branch_on_cast_argument,
        _ branch_on_cast_descriptor_equal_fail @branch_on_cast_argument,
    ],
    @branch_on_cast_argument : {from : @reference_type, to : @reference_type, label : @label},
    @call_instruction : [
        _ call @function_name,
        _ return_call @function_name,
        _ call_reference @function_type_name,
        _ return_call_reference @function_type_name,
        _ call_indirect @call_indirect_argument,
        _ return_call_indirect @call_indirect_argument,
    ],
    @call_indirect_argument : {table : @table_name, type : @function_type_name},
    @switch_instruction : [
        _ throw @tag_name,
        _ continuation.new @continuation_type_name,
        @continuation_type_name continuation.bind @continuation_type_name,
        _ suspend @tag_name,
        _ resume {type : @continuation_type_name, handlers : @resume_table},
        _ resume.throw {type : @continuation_type_name, tag : @tag_name, handlers : @resume_table},
        _ resume.throw_reference {type : @continuation_type_name, handlers : @resume_table},
        _ switch {type : @continuation_type_name, tag : @tag_name},
    ],
    @resume_table : [{tag : @tag_name, label : @label}],
    @local_instruction : [
        _ select @value_type,
        @local_name local.get _,
        @local_name local.set _,
        @local_name local.tee _,
    ],
    @local_name : @name,
    @global_instruction : [
        @global_name global.get _,
        @global_name global.set _,
        @global_name global.atomic.* @ordering,
    ],
    @ordering : [acquire_release, sequential_consistency],
    @memory_instruction : [
        @memory_name memory.init @data_name,
        @memory_name memory.size _,
        @memory_name memory.grow _,
        @memory_name memory.fill _,
        @memory_name memory.discard _,
        _ memory.copy {from : @memory_name, to : @memory_name},
        _ memory.atomic.* @memory_argument,
    ],
    @memory_argument : {align : @int, offset : @int, memory : @memory_name},
    @data_instruction : [
        _ data.drop @data_name,
    ],
    @table_instruction : [
        @table_name table.init @element_name,
        @table_name table.get _,
        @table_name table.set _,
        @table_name table.size _,
        @table_name table.grow _,
        @table_name table.fill _,
        _ table.copy {from : @table_name, to : @table_name},
        @table_name table.atomic.* @ordering,
    ],
    @element_instruction : [
        _ element.drop @element_name,
    ],
    @reference_instruction : [
        _ reference.null @heap_type,
        _ reference.function @function_name,
        _ reference.get_descriptor @type_name,
        _ reference.test_nullable @heap_type,
        _ reference.test_non_null @heap_type,
        _ reference.cast_nullable @heap_type,
        _ reference.cast_non_null @heap_type,
        _ reference.cast_descriptor_equal_nullable @heap_type,
        _ reference.cast_descriptor_equal_non_null @heap_type,
    ],
    @struct_instruction : [
        @struct_type_name struct.new _,
        @struct_type_name struct.new_default _,
        @struct_type_name struct.new_descriptor _,
        @struct_type_name struct.new_default_descriptor _,
        @struct_type_name struct.get* @field_name,
        @struct_type_name struct.set @field_name,
        @struct_type_name struct.atomic.* @field_name : @ordering,
    ],
    @array_instruction : [
        @array_type_name array.new _,
        @array_type_name array.new_default _,
        @array_type_name array.new_fixed @int,
        @array_type_name array.new_data @data_name,
        @array_type_name array.init_data @data_name,
        @array_type_name array.new_element @element_name,
        @array_type_name array.init_element @element_name,
        @array_type_name array.get* _,
        @array_type_name array.set _,
        @array_type_name array.fill _,
        _ array.copy {from : @array_type_name, to : @array_type_name},
        @array_type_name array.atomic.* @ordering,
    ],
    @number_instruction : [
        _ @iN.constant @int,
        _ @vN.constant @int,
        _ @fN.constant @decimal,
        _ @number.load*_lane* {..@memory_argument, lane : @int},
        _ @number.load* @memory_argument,
        _ @number.store*_lane* {..@memory_argument, lane : @int},
        _ @number.store* @memory_argument,
        _ @number.*_lane* @int,
        _ @iN.atomic.* @memory_argument,
        _ i8x16.shuffle [@int, @int, @int, @int, @int, @int, @int, @int,
            @int, @int, @int, @int, @int, @int, @int, @int],
    ],
    @number : [@iN, @fN, @vN],
    @iN : [i32, i64],
    @fN : [f32, f64],
    @vN : [v128],
    @constant_expression : [[@constant_instruction]],
    @constant_instruction : [@number.constant, global.get, ...],
    @type : [
        _ type @type_kind,
        _ type [@type_group_kind],
    ],
    @type_kind : [
        @function_type_name function {
            shared,
            input : [@value_type],
            output : [@value_type],
        },
        @struct_type_name struct {
            shared,
            fields : [{mutable} @field_name @storage_type],
        },
        @array_type_name array {
            shared,
            mutable,
            item : @storage_type,
        },
        @continuation_type_name continuation {
            shared,
            function : @function_type_name,
        },
    ],
    @type_group_kind : [
        @function_type_name function {
            ..@type_group_info,
            shared,
            input : [@value_type],
            output : [@value_type],
        },
        @struct_type_name struct {
            ..@type_group_info,
            shared,
            fields : [{mutable} @field_name @storage_type],
        },
        @array_type_name array {
            ..@type_group_info,
            shared,
            mutable,
            item : @storage_type,
        },
        @continuation_type_name continuation {
            ..@type_group_info,
            shared,
            function : @function_type_name,
        },
    ],
    @type_group_info : {
        final,
        parent : @type_name,
        descriptor : @type_name,
        describes : @type_name,
    },
    @type_name : @name,
    @function_type_name : @name,
    @struct_type_name : @name,
    @field_name : @name,
    @array_type_name : @name,
    @continuation_type_name : @name,
    @storage_type : [@packed_type, @value_type],
    @value_type : [@primitive_type, @reference_type],
    @reference_type : {nullable} reference @heap_type,
    @heap_type : [
        {abstract, shared} heap @abstract_heap_type,
        {exact} heap @type_name,
    ],
    @abstract_heap_type : [
        function, no_function, extern, no_extern, exception, no_exception,
        continuation, no_continuation, any, none, struct, array, i31, equal,
    ],
    @primitive_type : [i32, i64, f32, f64, v128],
    @packed_type : [i8, i16],
    @name : @key,
}
