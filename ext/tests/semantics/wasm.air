_ do _[
    _wasm.make set _ import .wasm.make,
    _wasm.parse set _ import .dev.wasm.parse,
    _b1 set _ wasm.make _({} module [
        _ type ft0 function {input : [], output : []},
        "module0" import "f0" : f0 function {type : ft0},
        "module1" import "g0" : g0 global {type : i32},
        "module2" import "m0" : m0 memory {min : 1},
        "module3" import "table0" : table0 table {
            min : 1, 
            type : {nullable} reference {abstract} heap function,
        },
        "module4" import "tag0" : tag0 tag {attribute : exception, type : ft0},
        "module5" import [
            "f1" : f1 function {type : ft0},
            "g1" : g1 global {type : i32},
            "m1" : m1 memory {min : 1},
            "table1" : table1 table {
                min : 1, 
                type : {nullable} reference {abstract} heap function,
            },
            "tag1" : tag1 tag {attribute : exception, type : ft0},
        ],
    ]),
    _b2 set _ wasm.parse "(module".
      '  (type (;0;) (func))'.
      '  (import "module0" "f0" (func (type 0)))'.
      '  (import "module1" "g0" (global i32))'.
      '  (import "module2" "m0" (memory 1))'.
      '  (import "module3" "table0" (table 1 funcref))'.
      '  (import "module4" "tag0" (tag (type 0)))'.
      '  (import "module5"'.
      '    (item "f1" (func (type 0)))'.
      '    (item "g1" (global i32))'.
      '    (item "m1" (memory 1))'.
      '    (item "table1" (table 1 funcref))'.
      '    (item "tag1" (tag (type 0)))'.
      '  )'.
      ')',
    b1 = b2
]
