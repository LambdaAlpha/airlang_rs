_ do _[
    _wasm.make set _ import .wasm.make,
    _wasm.parse set _ import .dev.wasm.parse,
    _b1 set _ wasm.make _({start : main} module [
        _ type type_main function {input : [], output : []},
        main function {type : type_main, input : [], local : []} : [nop],
    ]),
    _b2 set _ wasm.parse "(module (type (func)) (func (type 0) nop) (start 0))",
    b1 = b2
]
