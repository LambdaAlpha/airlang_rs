_ do _[
    _wasm.make set _ import .wasm.make,
    _wasm.parse set _ import .dev.wasm.parse,
    _b1 set _ wasm.make _({} module [
        _ type t0 function {
            input : [i32, i64, f32, f64],
            output : [v128, {} reference {abstract} heap function],
        },
        _ type t1 struct {fields : [
            {mutable} f0 i8,
            {} f1 i16,
            {mutable} f2 i32,
            {} f3 {nullable} reference {abstract} heap function,
            {mutable} f4 {} reference {abstract} heap no_function,
            {} f5 {nullable} reference {abstract} heap extern,
            {mutable} f6 {} reference {abstract} heap no_extern,
            {} f7 {nullable} reference {abstract} heap continuation,
            {mutable} f8 {} reference {abstract} heap no_continuation,
            {} f9 {nullable} reference {abstract} heap exception,
            {mutable} f10 {} reference {abstract} heap no_exception,
            {} f11 {nullable} reference {abstract} heap any,
            {mutable} f12 {} reference {abstract} heap none,
            {} f13 {nullable} reference {abstract} heap struct,
            {mutable} f14 {} reference {abstract} heap array,
            {} f15 {nullable} reference {abstract} heap i31,
            {mutable} f16 {} reference {abstract} heap equal,
            {} f17 {nullable} reference {abstract, shared} heap any,
            {mutable} f18 {} reference {} heap t0,
            {} f19 {nullable} reference {exact} heap t0,
        ]},
        _ type t2 array {mutable, item : i8},
        _ type t3 array {item : i16},
        _ type t4 continuation {function : t0},
        _ type [
            t5 function {input : [], output : [], final},
            t6 struct {fields : [{} f0 i8]},
            t7 struct {final, parent : t6, fields : [{} f0 i8, {} f1 i8]},
            t8 array {descriptor : t9, item : i32},
            t9 array {describes : t8, item : f64},
            t10 continuation {shared, function : t5},
        ],
    ]),
    _b2 set _ wasm.parse "(module".
      '  (type (;0;) (func (param i32 i64 f32 f64) (result v128 (ref func))))'.
      '  (type (;1;) (struct'.
      '    (field (;0;) (mut i8))'.
      '    (field (;1;) i16)'.
      '    (field (;2;) (mut i32))'.
      '    (field (;3;) (ref null func))'.
      '    (field (;4;) (mut (ref nofunc)))'.
      '    (field (;5;) (ref null extern))'.
      '    (field (;6;) (mut (ref noextern)))'.
      '    (field (;7;) (ref null cont))'.
      '    (field (;8;) (mut (ref nocont)))'.
      '    (field (;9;) (ref null exn))'.
      '    (field (;10;) (mut (ref noexn)))'.
      '    (field (;11;) (ref null any))'.
      '    (field (;12;) (mut (ref none)))'.
      '    (field (;13;) (ref null struct))'.
      '    (field (;14;) (mut (ref array)))'.
      '    (field (;15;) (ref null i31))'.
      '    (field (;16;) (mut (ref eq)))'.
      '    (field (;17;) (ref null (shared any)))'.
      '    (field (;18;) (mut (ref 0)))'.
      '    (field (;19;) (ref null (exact 0)))'.
      '  ))'.
      '  (type (;2;) (array (mut i8)))'.
      '  (type (;3;) (array i16))'.
      '  (type (;4;) (cont 0))'.
      '  (rec'.
      '    (type (;5;) (func))'.
      '    (type (;6;) (sub (struct (field i8))))'.
      '    (type (;7;) (sub final 6 (struct (field i8) (field i8))))'.
      '    (type (;8;) (sub (descriptor 9) (array i32)))'.
      '    (type (;9;) (sub (describes 8) (array f64)))'.
      '    (type (;10;) (sub (shared (cont 5))))'.
      '  )'.
      ')',
    b1 = b2
]
