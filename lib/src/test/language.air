parse generate
-----
_ do _[
    .any set _ import _value.any,
    .parse set _ import _language.syntax.parse,
    .generate set _ import _language.syntax.generate,
    .get set _ import _list.get,
    .% set _ import _integer.remainder,
    .atom set [_unit, _bit, _key, _text, _integer, _decimal, _byte],
    .i set 3 + (_ any _integer) % 4,
    .a set _ any .atom which get : i,
    _(_ any _bit) loop _[
        (_ any _bit) test _[
            .i set 3 + (_ any _integer) % 4,
            .b set _ any .atom which get : i,
            .i set (4 + (_ any _integer) % 4) % 4,
            .a set (_ any _bit) test _[a : b] : _[_ form _(_ a b)],
        ] : _[
            (_ any _bit) test _[
                .i set 3 + (_ any _integer) % 4,
                .b set _ any .atom which get : i,
                .a set [a, b],
            ] : _[
                .i set 3 + (_ any _integer) % 4,
                .b set _ any .atom which get : i,
                .a set {a : b},
            ]
        ]
    ],
    .repr set _ generate a,
    .(.a1) = _ parse repr,
    a == a1
]
