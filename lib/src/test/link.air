make which get_self
-----
_ do [
    .any set _ import _value.any,
    .make set _ import _link.make,
    .which set _ import _link.which,
    .get_self set _ import _context.get_self,
    .a set _ any .,
    .l set _ make a,
    .a1 set l which get_self : .,
    a == a1
]
-----
true
