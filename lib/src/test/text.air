get_length join
-----
_ do _[
    _any set _ import .value.any,
    _get_length set _ import .text.get_length,
    _join set _ import .text.join,
    _a set _ any .text,
    _la set _a which get_length : .,
    _b set _ any .text,
    _lb set _b which get_length : .,
    _ab set "" join [a, b],
    _lab set _ab which get_length : .,
    lab == la + lb
]
-----
true
=====
get_length empty
-----
_ do _[
    _get_length set _ import .text.get_length,
    _t set "",
    _t which get_length : .
]
-----
0
=====
get_length else
-----
_ do _[
    _get_length set _ import .text.get_length,
    _t set "1",
    _t which get_length : .
]
-----
1
