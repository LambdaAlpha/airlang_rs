into_utf8 from_utf8
-----
_ do _[
    _any set _ import .value.any,
    _from_utf8 set _ import .text.from_utf8,
    _into_utf8 set _ import .text.into_utf8,
    _t set _ any .text,
    _t1 set _ from_utf8 _ into_utf8 t,
    t == t1
]
