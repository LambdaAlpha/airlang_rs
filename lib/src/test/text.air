push join
-----
_ do _[
    _any set _ import .value.any,
    _push set _ import .text.push,
    _join set _ import .text.join,
    _a set _ any .text,
    _b set _ any .text,
    _t set a,
    _t which push : b,
    _t1 set "" join [a, b],
    t == t1
]
-----
true
=====
push
-----
_ do _[
    _push set _ import .text.push,
    _a set "hello",
    _b set "world",
    _a which push : " ",
    _a which push : b,
    a
]
-----
"hello world"
