    .a set _ any .,
    .b set _ any .,
    {_a : a} with _(_ do _[
        .c1 set _ exist _a,
        .c2 set {_b : b} with _(_ exist _b),
        .c3 set _ exist _b,
    ]),
    .c4 set _ exist _a,
    c1 and c2 and (_ not c3) and (_ not c4)
]
