with abort safe
-----
_ do _[
    .make set _ import _config.make,
    .link.make set _ import _link.make,
    .where set _ import _config.where,
    .recover set _ import _error.recover,
    .c set _ make {
        _prelude : _ link.make {
            with : with,
            do : do,
            abort : abort,
            exist : exist,
        },
    },
    .c where _(_ do _[
        {_a : 1} with _(_ abort .),
    ]),
    .c which recover : .,
    _ not .c where _(_ exist _a),
]
-----
true
