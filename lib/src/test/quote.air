make
-----
_ do _[
    _any set _ import .value.any,
    _v1 set _ any .,
    _q1 set _ quote v1,
    _(_(v2)) represent q1,
    v1 = v2
]
-----
true
=====
get
-----
_ do _[
    _any set _ import .value.any,
    _get_value set _ import .quote.get_value,
    _v set _ any .,
    _q set _ quote v,
    v = _q which get_value : .
]
-----
true
=====
set get
-----
_ do _[
    _any set _ import .value.any,
    _get_value set _ import .quote.get_value,
    _set_value set _ import .quote.set_value,
    _q set _ any .quote,
    _v1 set _ any .,
    _q which set_value : v1,
    _v2 set _q which get_value : .,
    v1 = v2
]
-----
true
=====
set return
-----
_ do _[
    _any set _ import .value.any,
    _set_value set _ import .quote.set_value,
    _v1 set _ any .,
    _q set _ quote v1,
    _v2 set _q which set_value : _ any .,
    v1 = v2
]
-----
true
