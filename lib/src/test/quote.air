get
-----
_ do _[
    _any set _ import .value.any,
    _get_source set _ import .quote.get_source,
    _v set _ any .,
    _c set _ form _(_(v)),
    v == _c which get_source : .
]
-----
true
=====
set get
-----
_ do _[
    _any set _ import .value.any,
    _get_source set _ import .quote.get_source,
    _set_source set _ import .quote.set_source,
    _c set _ any .quote,
    _v set _ any .,
    _c which set_source : v,
    _v1 set _c which get_source : .,
    v == v1
]
-----
true
=====
set return
-----
_ do _[
    _any set _ import .value.any,
    _set_source set _ import .quote.set_source,
    _v1 set _ any .,
    _c set _ form _(_(v1)),
    _v2 set _c which set_source : _ any .,
    v1 == v2
]
-----
true
