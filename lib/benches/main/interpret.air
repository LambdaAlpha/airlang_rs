!("bench interpret")

_ do _[
    _% set _ import .integer.remainder,
    _f set _ function {
        code : _((. : n) : _ do _[
            _sum set 0,
            n iterate _i : _[
                _ .try (0 = i % 3) test _[continue],
                _sum set sum + i,
            ],
            sum
        ]),
        prelude : {
            do : do,
            set : set,
            iterate : iterate,
            = : =,
            % : %,
            test : test,
            continue : continue,
            + : +,
        },
    },
    _ f 100
]
