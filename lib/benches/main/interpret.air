!("bench interpret")

_ do _[
    .% set _ import _integer.remainder,
    .f set _ function {
        code : (. : .n) : _ form _(_ do _[
            ..sum set 0,
            .n iterate ..i : _[
                _ _try (0 == .i % 3) test _[continue],
                ..sum set .sum + .i,
            ],
            .sum
        ]),
        prelude : {},
    },
    _ f 100
]
