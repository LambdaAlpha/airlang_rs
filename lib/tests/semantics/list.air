set_many get_many
-----
_ do _[
    _any set _ import .value.any,
    _get_length set _ import .list.get_length,
    _get_many set _ import .list.get_many,
    _set_many set _ import .list.set_many,
    _% set _ import .integer.remainder,
    _a set _ any .list,
    _la set _a which get_length : .,
    _ .try (la = 0) test [.(true)],
    _b set _ any .list,
    _lb set _b which get_length : .,
    _ .try (lb = 0) test [.(true)],
    (la < lb) test _[
        _t set a,
        _a set b,
        _b set t,
        _t set la,
        _la set lb,
        _lb set t,
    ],
    _a1 set a,
    _d set la - lb,
    _i set (d = 0) test [0] : _[(d + (_ any .integer) % d) % d],
    _c1 set _a which get_many : i : i + lb,
    _c2 set _a which set_many : i : b,
    _b1 set _a which get_many : i : i + lb,
    _a which set_many : i : c1,
    (b = b1) and (c1 = c2) and (a = a1)
]
