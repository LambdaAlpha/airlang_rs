make ?
-----
_ do _[
    _any set _ import .value.any,
    _i1 set _ any .integer,
    _i2 set _ any .integer,
    _sum set i1 + i2,
    .solver export _ function {
        code : (. : .) : fact call + : i1 : i2,
    },
    _(i3 : i4) is ? + sum,
    sum = i3 + i4
]
-----
true
=====
make get
-----
_ do _[
    _get_function set _ import .fact.get_function,
    _get_input set _ import .fact.get_input,
    _get_output set _ import .fact.get_output,
    _any set _ import .value.any,
    _i1 set _ any .integer,
    _i2 set _ any .integer,
    _sum set i1 + i2,
    _f set + fact i1 : i2,
    (+ = f get_function _) and (sum = f get_output _) and (i1 : i2) = f get_input _
]
-----
true
