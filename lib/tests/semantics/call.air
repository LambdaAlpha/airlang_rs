set get
-----
_ do _[
    _any set _ import .value.any,
    _get_function set _ import .call.get_function,
    _get_input set _ import .call.get_input,
    _set_function set _ import .call.set_function,
    _set_input set _ import .call.set_input,
    _c set _ any .call,
    _f set _ any .,
    _i set _ any .,
    _c which set_function : f,
    _c which set_input : i,
    (f = _c which get_function : .) and (i = _c which get_input : .)
]
-----
true
