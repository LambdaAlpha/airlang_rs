set return
-----
_ do _[
    _any set _ import .value.any,
    _set_function set _ import .call.set_function,
    _set_input set _ import .call.set_input,
    _f1 set _ any .,
    _i1 set _ any .,
    _c set f1 call i1,
    _f2 set _c which set_function : _ any .,
    _i2 set _c which set_input : _ any .,
    (f1 = f2) and (i1 = i2)
]
-----
true
