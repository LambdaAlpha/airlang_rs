make
-----
_ do _[
    _any set _ import .value.any,
    _f1 set _ any .,
    _i1 set _ any .,
    _c set f1 call i1,
    _(_ f2 i2) represent c,
    (f1 = f2) and (i1 = i2)
]
-----
true
