get
-----
_ do _[
    _any set _ import .value.any,
    _get_value set _ import .cell.get_value,
    _v set _ any .,
    _c set .(v),
    v = _c which get_value : .
]
-----
true
=====
set get
-----
_ do _[
    _any set _ import .value.any,
    _get_value set _ import .cell.get_value,
    _set_value set _ import .cell.set_value,
    _c set _ any .cell,
    _v set _ any .,
    _c which set_value : v,
    _v1 set _c which get_value : .,
    v = v1
]
-----
true
=====
set return
-----
_ do _[
    _any set _ import .value.any,
    _set_value set _ import .cell.set_value,
    _v1 set _ any .,
    _c set .(v1),
    _v2 set _c which set_value : _ any .,
    v1 = v2
]
-----
true
