    _set_output set _ import .solve.set_output,
    _s set _ any .solve,
    _f set _ any .,
    _o set _ any .,
    _s which set_function : f,
    _s which set_output : o,
    (f = _s which get_function : .) and (o = _s which get_output : .)
]
