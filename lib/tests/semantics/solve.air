make
-----
_ do _[
    _any set _ import .value.any,
    _f1 set _ any .,
    _o1 set _ any .,
    _s set f1 solve o1,
    _(? f2 o2) is s,
    (f1 = f2) and (o1 = o2)
]
-----
true
