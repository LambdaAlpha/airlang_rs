set return
-----
_ do _[
    _any set _ import .value.any,
    _set_function set _ import .solve.set_function,
    _set_output set _ import .solve.set_output,
    _f1 set _ any .,
    _o1 set _ any .,
    _s set f1 solve o1,
    _f2 set _s which set_function : _ any .,
